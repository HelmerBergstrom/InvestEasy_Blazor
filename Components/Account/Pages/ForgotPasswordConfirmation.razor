@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email</PageTitle>

<PageHeader Title="Check your email" Icon="bi-envelope-check" Eyebrow="Account">
    If there is an account with that email, we have sent a link to reset the password.
</PageHeader>

<section class="panel">
    <p>
        The link is valid for one day. If you can't find the email, check your spam folder.
    </p>
    <div class="account-actions">
        <a class="btn btn-primary-action" href="Account/Login">Go to log in</a>
    </div>
</section>

