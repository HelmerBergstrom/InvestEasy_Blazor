@page "/Account/RegisterConfirmation"

@inject IdentityRedirectManager RedirectManager

@* Accounts don't need email confirmation (RequireConfirmedAccount is false), so registration never ends here.
   The scaffolded page showed a confirmation link for any email address when no email sender is configured,
   which let anyone check which emails have accounts, so it now only redirects to the home page. *@

@code {
    protected override void OnInitialized()
    {
        RedirectManager.RedirectTo("");
    }
}
