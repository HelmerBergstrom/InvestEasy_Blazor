@page "/Account/RegisterConfirmation"

<PageTitle>Confirm your email</PageTitle>

<PageHeader Title="Check your email" Icon="bi-envelope-check" Eyebrow="Almost done">
    We have sent a confirmation link to your email address. Open it to activate your account, then log in.
</PageHeader>

@* The page shows the same text for every visitor, so it can't be used to find out which emails have accounts. *@
<section class="panel">
    <p>
        The email can take a minute to arrive. If you can't find it, check your spam folder.
    </p>
    <div class="account-actions">
        <a class="btn btn-primary-action" href="Account/Login">Go to log in</a>
        <a class="btn btn-outline" href="Account/ResendEmailConfirmation">Send the email again</a>
    </div>
</section>
