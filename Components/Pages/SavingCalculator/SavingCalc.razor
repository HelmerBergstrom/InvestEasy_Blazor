@page "/savingcalc"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using InvestEasy.Models
@using InvestEasy.Services

<PageTitle> Saving Calculator </PageTitle>

<PageHeader Title="Saving Calculator" Icon="bi-piggy-bank" Eyebrow="Tools">
    Plan, compare and estimate long-term savings. Adjust the values and see the result update instantly.
</PageHeader>

<div class="calc-layout">

    @if (editingScenarioId is not null)
    {
        <div class="alert-editing" role="status">
            <div>
                <strong>Edit mode:</strong> You are editing scenario "@editingScenarioName".
                Adjust the values and click <strong>Update scenario</strong>.
            </div>
            <button class="btn btn-outline" type="button" @onclick="CancelEdit">
                Exit edit mode
            </button>
        </div>
    }

    <!-- Inputs -->
    <section class="panel inputs-panel" aria-labelledby="inputs-heading">
        <h2 id="inputs-heading" class="panel-title"> Your plan </h2>

        <div class="field">
            <label for="name"> Scenario name </label>
            <input id="name" class="form-input" type="text" maxlength="60"
                   placeholder="Ex: Buffer, House, Retirement"
                   @bind="model.Name" @bind:event="oninput" />
        </div>

        <div class="field">
            <label for="initial"> Initial amount </label>
            <div class="input-with-unit">
                <input id="initial" class="form-input" type="number" min="0" step="1000" inputmode="numeric"
                       @bind="model.InitialAmount" @bind:after="Recalculate" />
                <span class="unit" aria-hidden="true"> kr </span>
            </div>
        </div>

        <div class="field">
            <div class="field-header">
                <label for="monthly"> Monthly savings </label>
                <div class="input-with-unit compact">
                    <input id="monthly" class="form-input" type="number" min="@MonthlyMin" max="@MonthlyMax" step="100" inputmode="numeric"
                           @bind="model.MonthlyAmount" @bind:after="Recalculate" />
                    <span class="unit" aria-hidden="true"> kr </span>
                </div>
            </div>
            <input type="range" class="slider" min="@MonthlyMin" max="@MonthlyMax" step="500"
                   aria-label="Monthly savings slider"
                   aria-valuetext="@($"{model.MonthlyAmount:N0} kr per month")"
                   style="--fill: @FillPercent(model.MonthlyAmount, MonthlyMin, MonthlyMax)"
                   @bind="model.MonthlyAmount" @bind:event="oninput" @bind:after="Recalculate" />
            <div class="range-scale" aria-hidden="true">
                <span> @MonthlyMin kr </span>
                <span> @MonthlyMax.ToString("N0") kr </span>
            </div>
        </div>

        <div class="field">
            <div class="field-header">
                <label for="years"> Saving horizon </label>
                <div class="input-with-unit compact">
                    <input id="years" class="form-input" type="number" min="@YearsMin" max="@YearsMax" inputmode="numeric"
                           @bind="model.SavingHorizon" @bind:after="Recalculate" />
                    <span class="unit" aria-hidden="true"> years </span>
                </div>
            </div>
            <input type="range" class="slider" min="@YearsMin" max="@YearsMax" step="1"
                   aria-label="Saving horizon slider"
                   aria-valuetext="@($"{model.SavingHorizon} years")"
                   style="--fill: @FillPercent(model.SavingHorizon, YearsMin, YearsMax)"
                   @bind="model.SavingHorizon" @bind:event="oninput" @bind:after="Recalculate" />
            <div class="range-scale" aria-hidden="true">
                <span> @YearsMin year </span>
                <span> @YearsMax years </span>
            </div>
        </div>

        <div class="field">
            <div class="field-header">
                <label for="return"> Expected annual return </label>
                <div class="input-with-unit compact">
                    <input id="return" class="form-input" type="number" min="@ReturnMin" max="@ReturnMax" inputmode="numeric"
                           @bind="model.ExpectedReturnPercent" @bind:after="Recalculate" />
                    <span class="unit" aria-hidden="true"> % </span>
                </div>
            </div>
            <input type="range" class="slider" min="@ReturnMin" max="@ReturnMax" step="1"
                   aria-label="Expected annual return slider"
                   aria-valuetext="@($"{model.ExpectedReturnPercent} percent per year")"
                   style="--fill: @FillPercent(model.ExpectedReturnPercent, ReturnMin, ReturnMax)"
                   @bind="model.ExpectedReturnPercent" @bind:event="oninput" @bind:after="Recalculate" />

            <div class="presets" role="group" aria-label="Return presets">
                @foreach (var preset in returnPresets)
                {
                    <button type="button" class="preset @(model.ExpectedReturnPercent == preset.Percent ? "active" : "")"
                            aria-pressed="@(model.ExpectedReturnPercent == preset.Percent ? "true" : "false")"
                            @onclick="() => SetReturn(preset.Percent)">
                        @preset.Label <span class="preset-value">@preset.Percent%</span>
                    </button>
                }
            </div>
        </div>

        <button type="button" class="btn btn-ghost reset-btn" @onclick="ClearCalculation">
            Reset values
        </button>
    </section>

    <!-- Results -->
    <section class="panel results-panel" aria-labelledby="results-heading">
        <h2 id="results-heading" class="panel-title">
            @(string.IsNullOrWhiteSpace(model.Name) ? "Your result" : $"Result: {model.Name}")
        </h2>

        <div class="hero">
            <p class="hero-label"> Estimated value after @model.SavingHorizon @(model.SavingHorizon == 1 ? "year" : "years") </p>
            <p class="hero-value"> @futureValue.ToString("N0") <span class="hero-unit">kr</span></p>
        </div>

        <div class="stat-row">
            <div class="stat">
                <span class="stat-label"><span class="swatch invested"></span> Invested </span>
                <span class="stat-value"> @totalInvestment.ToString("N0") kr </span>
            </div>
            <div class="stat">
                <span class="stat-label"><span class="swatch returns"></span> Returns </span>
                <span class="stat-value"> @totalReturn.ToString("N0") kr </span>
                <span class="stat-note"> @ReturnShare% of the final value </span>
            </div>
        </div>

        <GrowthChart Points="growth" />

        @if (breakEvenYear is not null)
        {
            <p class="insight">
                <span aria-hidden="true">✦</span>
                From <strong>year @breakEvenYear</strong> your returns are larger than everything you have deposited.
                That is compound interest at work.
            </p>
        }
        else if (model.ExpectedReturnPercent == 0)
        {
            <p class="insight">
                <span aria-hidden="true">✦</span>
                With 0% return your savings only grow by what you deposit. Try a higher return to see compound interest.
            </p>
        }

        <div class="result-actions">
            @if (editingScenarioId is null)
            {
                <button class="btn btn-primary-action" type="button" @onclick="SaveScenario">
                    Save scenario
                </button>
            }
            else
            {
                <button class="btn btn-primary-action" type="button" @onclick="UpdateScenario">
                    Update scenario
                </button>
                <button class="btn btn-outline" type="button" @onclick="CancelEdit">
                    Cancel edit
                </button>
            }
        </div>

        <div role="status">
            @if (!string.IsNullOrWhiteSpace(saveMessage))
            {
                <p class="message success"> @saveMessage </p>
            }
            @if (!string.IsNullOrWhiteSpace(saveError))
            {
                <p class="message error"> @saveError </p>
            }
        </div>

        <p class="disclaimer">
            Assumes monthly deposits and monthly compounding based on the stated annual return. Real returns vary
            from year to year, and this is not financial advice.
        </p>
    </section>
</div>

<!-- Saved scenarios -->
@if (editingScenarioId is null)
{
    <section class="saved-section" aria-labelledby="saved-heading">
        <div class="section-header">
            <div>
                <h2 id="saved-heading" class="section-title">
                    Saved scenarios
                    @if (savedScenarios.Any())
                    {
                        <span class="count-badge"> @savedScenarios.Count </span>
                    }
                </h2>
                <p class="section-subtitle"> Compare your plans side by side. Edit a scenario to load it into the calculator. </p>
            </div>
        </div>

        @if (!savedScenarios.Any())
        {
            <div class="empty-state">
                <i class="bi bi-bookmark-plus" aria-hidden="true"></i>
                <p> No saved scenarios yet. Give your plan a name and click <strong>Save scenario</strong>. </p>
            </div>
        }
        else
        {
            <ul class="scenario-grid">
                @foreach (SavingScenarioModel s in savedScenarios)
                {
                    var value = CalculatorService.CalculateFutureValue(s.MonthlyAmount, s.InitialAmount, s.SavingHorizon, s.ExpectedReturnPercent);
                    var invested = CalculatorService.CalculateTotalInvestment(s.MonthlyAmount, s.InitialAmount, s.SavingHorizon);
                    var returns = Math.Max(0, value - invested);

                    <li class="scenario-card">
                        <div class="scenario-head">
                            <span class="icon-tile" aria-hidden="true"><i class="bi bi-piggy-bank"></i></span>
                            <div class="scenario-heading">
                                <h3> @s.Name </h3>
                                <span class="scenario-date"> Saved @s.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd") </span>
                            </div>
                        </div>

                        <div class="scenario-result">
                            <span class="scenario-result-label"> Estimated value after @s.SavingHorizon @(s.SavingHorizon == 1 ? "year" : "years") </span>
                            <span class="scenario-value"> @value.ToString("N0") <span class="scenario-unit">kr</span></span>
                        </div>

                        <div class="composition">
                            <div class="mini-bar" aria-hidden="true">
                                <span class="seg invested" style="flex-grow: @Invariant(invested)"></span>
                                @if (returns > 0)
                                {
                                    <span class="seg returns" style="flex-grow: @Invariant(returns)"></span>
                                }
                            </div>
                            <div class="composition-legend">
                                <span><span class="swatch invested"></span> Invested <strong>@invested.ToString("N0") kr</strong></span>
                                <span><span class="swatch returns"></span> Returns <strong>@returns.ToString("N0") kr</strong></span>
                            </div>
                        </div>

                        <dl class="scenario-facts">
                            <div>
                                <dt><i class="bi bi-calendar3" aria-hidden="true"></i> Monthly </dt>
                                <dd> @s.MonthlyAmount.ToString("N0") kr </dd>
                            </div>
                            <div>
                                <dt><i class="bi bi-wallet2" aria-hidden="true"></i> Initial </dt>
                                <dd> @s.InitialAmount.ToString("N0") kr </dd>
                            </div>
                            <div>
                                <dt><i class="bi bi-hourglass-split" aria-hidden="true"></i> Horizon </dt>
                                <dd> @s.SavingHorizon years </dd>
                            </div>
                            <div>
                                <dt><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Return </dt>
                                <dd> @s.ExpectedReturnPercent% / year </dd>
                            </div>
                        </dl>

                        <div class="scenario-actions">
                            <button class="btn btn-outline" type="button" aria-label="@($"Edit scenario {s.Name}")"
                                    @onclick="() => StartEditScenario(s.Id)">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                            <button class="btn btn-danger-outline" type="button" aria-label="@($"Delete scenario {s.Name}")"
                                    @onclick="() => DeleteScenario(s.Id)">
                                <i class="bi bi-trash3" aria-hidden="true"></i> Delete
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}
