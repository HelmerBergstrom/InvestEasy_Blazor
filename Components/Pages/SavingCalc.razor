@page "/savingcalc"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

@using BlazorBootstrap

@using InvestEasy.Models
@using InvestEasy.Services


<PageTitle> Saving Calculator </PageTitle>

<div class="page-header">
    <h1 class="page-title">Saving Calculator</h1>
    <p class="page-subtitle">Plan, compare and estimate long-term savings with monthly compounding.
        The calculation assumes monthly compound interest based on stated annual return.
    </p>
</div>


<div class="saving-calc">

    @if (editingScenarioId is not null)
    {
        <div class="alert-editing">
            <div>
                <strong>Edit mode:</strong> You are editing scenario "@model.Name".
                <br>
                Update the values and click <strong>Update scenario</strong>.
            </div>
            <button class="btn btn-secondary" type="button" @onclick="CancelEdit">
                Exit edit mode
            </button>
        </div>
    }


    <!-- Enhance = false to prevent site reloading. -->
    <EditForm class="form" Model="@model" OnValidSubmit="Calculate" Enhance="false" FormName="SavingCalculatorForm">
        <DataAnnotationsValidator />

        <!-- Error-messages in summary (in a list) -->
        <div class="error-messages">
            <ValidationSummary />
        </div>

        <div class="input-group">
            <label for="name"> Scenario name </label>
            <InputText id="name" class="form-input" @bind-Value="model.Name" />
        </div>

        <div class="input-group">
            <label for="initial"> Initial amount </label>
            <InputNumber id="initial" class="form-input" @bind-Value="model.InitialAmount" />
        </div>

        <div class="input-group">
            <label for="monthly"> Monthly savings </label>
            <RangeInput TValue="int" @bind-Value="model.MonthlyAmount" Min="0" Max="15000" Step="500" />
            <Badge Color="BadgeColor.Primary" visuallyHiddenText="model.MonthlyAmount">
                @model.MonthlyAmount</Badge>
        </div>


        <div class="input-group">
            <label for="years"> Saving horizon (years)</label>
            <InputNumber id="years" class="form-input" @bind-Value="model.SavingHorizon" />
        </div>

        <div class="input-group">
            <label for="return"> Expected annual return (%)</label>
            <InputNumber id="return" class="form-input" @bind-Value="model.ExpectedReturnPercent" />
        </div>

        <button type="submit" class="btn btn-success"> Calculate </button>
        <button type="button" class="btn btn-danger" @onclick="ClearCalculation"> Reset form </button>
    </EditForm>

    <!-- If hasCalculated turns true, display results -->
    @if (hasCalculated)
    {
        <div class="summary">
            <br>
            <h3> Summary of scenario "@model.Name" </h3>
            <p><strong> Initial amount:</strong> @model.InitialAmount </p>
            <p><strong> Monthly savings:</strong> @model.MonthlyAmount </p>
            <p><strong> Saving horizon:</strong> @model.SavingHorizon years</p>
            <p><strong> Expected annual return:</strong> @model.ExpectedReturnPercent%</p>
        </div>

        <div class="result-box">
            <h3> Results of scenario "@model.Name" </h3>

            <p><strong> Total investment:</strong> @totalInvestment.ToString("N0")</p>
            <p><strong> Total returns:</strong> @totalReturn.ToString("N0")</p>
            <p><strong> Final value (after @model.SavingHorizon years):</strong> @futureValue.ToString("N0")</p>
        </div>

        <div class="calculation-btns">

            @if (editingScenarioId is null)
            {
                <button class="btn btn-success" @onclick="async () => { await SaveScenario(); ClearCalculation(); }">
                    Save scenario
                </button>
                <button class="btn btn-danger ms-2" @onclick="ClearCalculation" type="button">
                    Start over
                </button>
            }
            else
            {
                <button class="btn btn-warning" @onclick="async () => { await UpdateScenario(); ClearCalculation(); }">
                    Update scenario
                </button>

                <button class="btn btn-secondary ms-2" type="button" @onclick="CancelEdit">
                    Cancel edit
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <p class="text-success"> @saveMessage </p>
        }
        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <p class="text-danger"> @saveError </p>
        }
    }

</div>


<div class="saving-calc">
    @if (savedScenarios.Any() && editingScenarioId is null)
    {
        <h3> Saved scenarios </h3>

        @foreach (SavingScenarioModel s in savedScenarios)
        {
            var futureValue = CalculatorService.CalculateFutureValue(
            s.MonthlyAmount,
            s.InitialAmount,
            s.SavingHorizon,
            s.ExpectedReturnPercent);

            <br />

            <h4><strong> @s.Name - @s.CreatedDate </strong></h4>
            <p><strong> Monthly saving:</strong> @s.MonthlyAmount.ToString(format: "N0") </p>
            <p><strong> Initial amount:</strong> @s.InitialAmount.ToString(format: "N0") </p>
            <p><strong> Time horizon:</strong> @s.SavingHorizon years </p>
            <p><strong> Expected annual return:</strong> @s.ExpectedReturnPercent.ToString(format: "N0")% </p>
            <p class="final-value-saving"><strong>Final value: @futureValue.ToString("N0")</strong></p>


            <div class="calculation-btns-saved">
                <button class="btn btn-success" type="button" @onclick="() => StartEditScenario(s.Id)">
                    Edit Scenario
                </button>
                <button class="btn btn-danger" type="button" @onclick="() => DeleteScenario(s.Id)">
                    Delete Scenario
                </button>
            </div>

        }
    }
    else if (!savedScenarios.Any())
    {
        <p> No saved scenarios yet. </p>
    }

</div>