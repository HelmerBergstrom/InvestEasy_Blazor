@page "/"

<PageTitle> InvestEasy </PageTitle>

<div class="home-first">
    <div class="home-logo">
        <img src="images/investEasy.png" class="logo" alt="InvestEasy - Since 2026 (logo)">
    </div>

    <div class="page-header">
        <h1 class="page-title"> InvestEasy </h1>
        <p class="page-subtitle">
            Learn how to invest, analyze markets, and build your own strategy with practical tools and educational
            resources.
        </p>
    </div>
    <div>
        <p style="font-size: 3rem; text-align: center;"> ⬇️ </p>
    </div>
</div>

<section class="platform-section">
    <div class="platform-header">
        <h2>Explore the Platform</h2>
        <p>
            Access the main parts of InvestEasy and continue building your knowledge,
            tracking markets, and using the practical tools available in the app.
        </p>
    </div>

    <div class="platform-grid">
        <a class="platform-card" href="/market">
            <h3> 📊 Markets </h3>
            <p>Follow market news, major indexes, and stock data in one place.</p>
        </a>

        <a class="platform-card" href="/market/watchlist">
            <h3> 👓 My Watchlist </h3>
            <p>Track selected stocks and monitor how they move over time.</p>
        </a>

        <a class="platform-card" href="/education">
            <h3> 📚 Academy </h3>
            <p>Learn investing step by step through structured educational levels.</p>
        </a>

        <a class="platform-card" href="/riskprofile">
            <h3> ☣️ Risk Profile </h3>
            <p>Get a suggested allocation based on your goals and tolerance for risk.</p>
        </a>

        <a class="platform-card" href="/savingcalc">
            <h3> 💰 Savings Calculator </h3>
            <p>Estimate how your savings may grow over time with different inputs.</p>
        </a>
    </div>
</section>