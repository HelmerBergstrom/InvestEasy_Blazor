@page "/education/level1"
@rendermode InteractiveServer
@using InvestEasy.Services
@inject UserProgressService UserProgressService
@inject CurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle> Level 1 </PageTitle>

<PageHeader Title="Investing Basics" Eyebrow="Academy · Level 1" Icon="bi-journal-text"
            BackHref="/education" BackText="Back to Academy" Width="narrow">
    Read the lesson, check your knowledge with the questions and complete the level to unlock the next one.
</PageHeader>

<div class="page-container narrow">

    <div class="level-content">

        <Level1Content />

        <h2> Knowledge Check </h2>

        <section class="lesson-card">
            <h3> Questions and Answers </h3>
            <p>
                Review the most important concepts from this level by expanding each question to reveal the answer.
            </p>

            <div class="qa-list">
                <details class="qa-item">
                    <summary> What does a stock represent? </summary>
                    <p><strong>Answer: </strong> A stock represents a small ownership share in a company. </p>
                </details>

                <details class="qa-item">
                    <summary> What is the main difference between a stock and a fund? </summary>
                    <p><strong>Answer: </strong> A stock gives you ownership in one company, while a fund spreads your
                        money across many
                        investments.</p>
                </details>

                <details class="qa-item">
                    <summary> Why do stock prices change? </summary>
                    <p><strong>Answer: </strong> Stock prices change because of supply and demand, company performance,
                        and investor expectations.
                    </p>
                </details>

                <details class="qa-item">
                    <summary> Why are funds often considered less risky than individual stocks? </summary>
                    <p><strong>Answer: </strong> Funds are usually more diversified, which reduces the impact of one
                        company performing badly.</p>
                </details>

                <details class="qa-item">
                    <summary> What usually happens if you sell a stock for more than you paid? </summary>
                    <p><strong>Answer: </strong> You make a profit because you sold the stock at a higher price than
                        your purchase price.</p>
                </details>
            </div>
        </section>

        <div class="complete-task-btn">
            <button class="btn btn-primary-action" type="button" @onclick="CompleteLevel1Async">
                <i class="bi bi-check2-circle" aria-hidden="true"></i> Complete level 1
            </button>
        </div>
    </div>
</div>


@code {
    // sets level 1 to completed for user.
    private async Task CompleteLevel1Async()
    {
        string? userId = await CurrentUserService.GetUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        await UserProgressService.CompleteLevelAsync(userId, levelNumber: 1);
        Navigation.NavigateTo(uri: "/education");
    }
}