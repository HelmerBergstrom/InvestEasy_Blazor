@page "/education"
@using Microsoft.AspNetCore.Authorization
@using InvestEasy.Services
@using InvestEasy.Models
@attribute [Authorize]
@inject UserProgressService UserProgressService
@inject CurrentUserService CurrentUserService

<PageTitle>Academy</PageTitle>

@if (isLoading)
{
    <p> Loading... </p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p> @errorMessage </p>
}
else if (progress is not null)
{
    <div class="page-header">
        <h1 class="page-title"> Academy </h1>
        <p class="page-subtitle">
            Learn the fundamentals of investing with InvestEasy´s Academy
        </p>
    </div>

    <section class="levels">

        <div class="level-card available-card">
            <div class="level-card-header">
                <span class="level-badge"> Level 1 </span>
                <span class="level-status completed-status">@(progress.Level1Completed ? "Completed" : "Available")</span>
            </div>

            <h2> The foundation </h2>
            <p class="level-description">
                Start with the core concepts of investing and build a strong foundation before
                moving on to more advanced topics.
            </p>
            <p>
                <strong> Status:</strong>
                @(progress.Level1Completed ? "Completed" : "Not completed")
            </p>
            <p><strong> Time required: </strong> 30 minutes </p>

            <div class="level-footer">
                <a class="btn btn-primary" href="/education/level1"> Take course </a>
            </div>
        </div>

        <div class="level-card @(isLevel2Unlocked ? "available-card" : "locked-card")">
            <div class="level-card-header">
                <span class="level-badge">Level 2</span>
                <span class="level-status @(isLevel2Unlocked ? "available-status" : "locked-status")">
                    @(progress.Level2Completed ? "Completed" : (isLevel2Unlocked ? "Not completed" : "Locked"))
                </span>
            </div>

            <h2> Move forward </h2>
            <p class="level-description">
                Move on to risk, strategy, and portfolio thinking once the first level has been
                completed.
            </p>
            <p>
                <strong> Status:</strong>
                @(progress.Level2Completed ? "Completed" : (isLevel2Unlocked ? "Not completed" : "Locked"))
            </p>
            <p><strong> Time required:</strong> 15 minutes</p>

            <div class="level-footer">
                @if (isLevel2Unlocked)
                {
                    <a class="btn btn-primary" href="/education/level2"> Go to Level 2 </a>
                }
                else
                {
                    <button class="btn btn-secondary" type="button" disabled> Locked </button>
                }
            </div>
        </div>

        <div class="level-card @(isLevel3Unlocked ? "available-card" : "locked-card")">
            <div class="level-card-header">
                <span class="level-badge">Level 3</span>
                <span class="level-status @(isLevel3Unlocked ? "available-status" : "locked-status")">
                    @(progress.Level3Completed ? "Completed" : (isLevel3Unlocked ? "Not completed" : "Locked"))
                </span>
            </div>

            <h2> Knowledge </h2>
            <p class="level-description">
                Apply your knowledge in a more advanced context and continue developing your investing understanding.
            </p>
            <p>
                <strong> Status:</strong>
                @(progress.Level3Completed ? "Completed" : (isLevel3Unlocked ? "Not completed" : "Locked"))
            </p>
            <p><strong> Time required:</strong> 20 minutes</p>

            <div class="level-footer">
                @if (isLevel3Unlocked)
                {
                    <a class="btn btn-primary" href="/education/level3"> Go to Level 3 </a>
                }
                else
                {
                    <button class="btn btn-secondary" type="button" disabled> Locked </button>
                }
            </div>
        </div>
    </section>
}

@code {
    private UserProgressModel? progress;
    private bool isLoading = true;
    private string? errorMessage;

    private bool isLevel2Unlocked;
    private bool isLevel3Unlocked;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // gets userId.
            string? userId = await CurrentUserService.GetUserIdAsync();

            if (string.IsNullOrWhiteSpace(userId))
            {
                errorMessage = "No user found.";
                return;
            }

            // gets or creates progress
            progress = await UserProgressService.GetOrCreateProgressAsync(userId);

            // checks if level 2 and 3 are completed.
            isLevel2Unlocked = UserProgressService.IsLevelUnlocked(progress, levelNumber: 2);
            isLevel3Unlocked = UserProgressService.IsLevelUnlocked(progress, levelNumber: 3);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}