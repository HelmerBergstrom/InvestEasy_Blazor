@page "/education"
@using Microsoft.AspNetCore.Authorization
@using InvestEasy.Services
@using InvestEasy.Models
@attribute [Authorize]
@inject UserProgressService UserProgressService
@inject CurrentUserService CurrentUserService

<PageTitle>Academy</PageTitle>

<PageHeader Title="Academy" Icon="bi-mortarboard" Eyebrow="Learn">
    Learn the fundamentals of investing step by step. Complete a level to unlock the next one.
</PageHeader>

<div class="page-container">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="message error" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @errorMessage
        </p>
    }
    else if (progress is not null)
    {
        <!-- Progress overview -->
        <section class="panel progress-panel" aria-labelledby="progress-heading">
            <div class="progress-text">
                <h2 id="progress-heading" class="panel-title"> Your progress </h2>
                <p>
                    @if (CompletedCount == levels.Count)
                    {
                        <text>You have completed every level. Great work!</text>
                    }
                    else
                    {
                        <text>@CompletedCount of @levels.Count levels completed. Next up: <strong>Level @NextLevel</strong>.</text>
                    }
                </p>
            </div>
            <div class="progress-meter">
                <span class="progress-value">@ProgressPercent%</span>
                <div class="progress-track" role="progressbar" aria-label="Academy progress"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressPercent">
                    <span class="progress-fill" style="width: @(ProgressPercent)%"></span>
                </div>
            </div>
        </section>

        <!-- Levels -->
        <ol class="levels">
            @foreach (var level in levels)
            {
                bool unlocked = UserProgressService.IsLevelUnlocked(progress, level.Number);
                bool completed = IsCompleted(level.Number);

                <li class="level-card @(unlocked ? "" : "locked") @(completed ? "completed" : "")">
                    <div class="level-card-header">
                        <span class="level-number" aria-hidden="true">
                            @if (completed)
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else
                            {
                                @level.Number
                            }
                        </span>

                        @if (completed)
                        {
                            <span class="pill pill-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Completed </span>
                        }
                        else if (unlocked)
                        {
                            <span class="pill pill-info"><i class="bi bi-play-circle" aria-hidden="true"></i> Available </span>
                        }
                        else
                        {
                            <span class="pill pill-muted"><i class="bi bi-lock" aria-hidden="true"></i> Locked </span>
                        }
                    </div>

                    <p class="level-label"> Level @level.Number </p>
                    <h2> @level.Title </h2>
                    <p class="level-description"> @level.Description </p>

                    <p class="level-meta">
                        <i class="bi bi-clock" aria-hidden="true"></i> @level.Minutes minutes
                    </p>

                    <div class="level-footer">
                        @if (unlocked)
                        {
                            <a class="btn @(completed ? "btn-outline" : "btn-primary-action")" href="@($"/education/level{level.Number}")">
                                @(completed ? "Review level" : "Start level")
                                <span class="visually-hidden"> @level.Number</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <p class="locked-hint">
                                <i class="bi bi-lock" aria-hidden="true"></i> Complete level @(level.Number - 1) to unlock
                            </p>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</div>

@code {
    private UserProgressModel? progress;
    private string? errorMessage;

    private record Level(int Number, string Title, string Description, int Minutes);

    private readonly List<Level> levels = new()
    {
        new(1, "The foundation", "Start with the core concepts of investing and build a strong foundation before moving on to more advanced topics.", 15),
        new(2, "Move forward", "Move on to risk, strategy and portfolio thinking. Takes you one step closer to a full understanding of smart investing.", 10),
        new(3, "Knowledge", "Apply what you have learned and deepen your understanding with more advanced investment strategies and concepts.", 10)
    };

    private bool IsCompleted(int levelNumber) => levelNumber switch
    {
        1 => progress!.Level1Completed,
        2 => progress!.Level2Completed,
        3 => progress!.Level3Completed,
        _ => false
    };

    private int CompletedCount => levels.Count(l => IsCompleted(l.Number));
    private int ProgressPercent => (int)Math.Round(100.0 * CompletedCount / levels.Count);
    private int NextLevel => levels.FirstOrDefault(l => !IsCompleted(l.Number))?.Number ?? levels.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // gets userId.
            string? userId = await CurrentUserService.GetUserIdAsync();

            if (string.IsNullOrWhiteSpace(userId))
            {
                errorMessage = "No user found.";
                return;
            }

            // gets or creates progress
            progress = await UserProgressService.GetOrCreateProgressAsync(userId);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}