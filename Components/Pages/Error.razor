@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<PageHeader Title="Something went wrong" Icon="bi-exclamation-triangle" Eyebrow="Error" Width="narrow">
    An error occurred while processing your request. Please try again in a moment.
</PageHeader>

<div class="page-container narrow">
    <section class="panel">
        @if (ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong> <code>@RequestId</code>
            </p>
        }

        <p>If the problem continues, go back to the home page and try again.</p>
    </section>

    <div class="status-actions">
        <a class="btn btn-primary-action" href="/"><i class="bi bi-house" aria-hidden="true"></i> Go to home</a>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
