@page "/RiskProfile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

@using InvestEasy.Models
@using InvestEasy.Services

@inject RiskProfileService RiskProfileService
@inject CurrentUserService CurrentUserService


<PageTitle> Risk Profile </PageTitle>

<div class="page-header">
    <h1 class="page-title"> Risk Profile </h1>
    <p class="page-subtitle">
        Answer a few questions to get a suggested portfolio allocation based on your goals and risk tolerance.
    </p>
</div>

<RiskProfileQA Model="model" OnAnswerChanged="StateHasChanged" @key="model" />

<div class="calculate-btn">
    <button class="btn btn-primary" @onclick="CalculateProfile" disabled="@(!CanCalculate)">
        Calculate Risk Profile
    </button>
</div>

@if (hasResult)
{
    <section class="risk-result">

        <h2> Your Suggested Risk Profile </h2>

        <div class="calculated-results">

            <p style="text-decoration: underline; text-transform: uppercase;">@model.ProfileName</p>


            <div class="result-div">
                <strong> Stocks </strong>
                <p>@model.StocksPercentage%</p>
            </div>

            <div class="result-div">
                <strong> Funds </strong>
                <p>@model.FundsPercentage%</p>
            </div>

            <div class="result-div">
                <strong> Low risk / savings </strong>
                <p>@model.MinimalRiskPercentage%</p>
            </div>

        </div>

        <div class="result-actions">
            <button class="btn btn-success" @onclick="SaveRiskProfile">
                Save Risk Profile
            </button>

            <button class="btn btn-secondary" @onclick="ResetRiskProfile">
                Start Over
            </button>
        </div>

    </section>
}


@code {

    private RiskProfileModel model = new RiskProfileModel
    {
        TimeHorizon = -1,
        MarketDropReaction = -1,
        InvestmentGoal = -1,
        ExperienceLevel = -1
    };
    private bool hasResult = false;

    // boolean for control if question values are 0 or more.
    private bool CanCalculate =>
    model.TimeHorizon >= 0 &&
    model.MarketDropReaction >= 0 &&
    model.InvestmentGoal >= 0 &&
    model.ExperienceLevel >= 0;

    // calculates riskprofile via CalculateProfile and user input.
    private async Task CalculateProfile()
    {
        // gets userId
        string? userId = await CurrentUserService.GetUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        if (!CanCalculate)
        {
            return;
        }

        model.UserId = userId;

        RiskProfileService.CalculateProfile(model);

        hasResult = true;
    }

    // Saves risk profile
    private Task SaveRiskProfile()
    {
        return Task.CompletedTask;
    }

    // resets users answers.
    private void ResetRiskProfile()
    {
        model = new RiskProfileModel
        {
            TimeHorizon = -1,
            MarketDropReaction = -1,
            InvestmentGoal = -1,
            ExperienceLevel = -1
        };

        hasResult = false;
    }

}