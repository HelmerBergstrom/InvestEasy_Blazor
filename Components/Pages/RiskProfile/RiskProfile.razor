@page "/RiskProfile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@using InvestEasy.Data
@using InvestEasy.Models
@using InvestEasy.Services
@using Microsoft.EntityFrameworkCore


<PageTitle> Risk Profile </PageTitle>

<div class="page-header">
    <h1 class="page-title"> Risk Profile </h1>
    <p class="page-subtitle">
        Answer a few questions to get a suggested portfolio allocation based on your goals and risk tolerance.
    </p>
</div>

@if (!hasResult)
{

    <RiskProfileQA Model="model" OnAnswerChanged="StateHasChanged" @key="model" />

    <div class="calculate-btn">
        <button class="btn btn-primary" @onclick="CalculateProfile" disabled="@(!CanCalculate)">
            Calculate Risk Profile
        </button>
    </div>
}


@if (hasResult)
{
    <section class="risk-result">

        <h2> Suggested Risk Profile </h2>

        <div class="calculated-results">

            <p><strong> Profile: </strong> @model.ProfileName </p>

            <AllocationChart Profile="model" />


            <div class="result-div">
                <strong><span class="swatch stocks"></span> Stocks </strong>
                <p>@model.StocksPercentage%</p>
            </div>

            <div class="result-div">
                <strong><span class="swatch funds"></span> Funds </strong>
                <p>@model.FundsPercentage%</p>
            </div>

            <div class="result-div">
                <strong><span class="swatch low-risk"></span> Low risk / savings </strong>
                <p>@model.MinimalRiskPercentage%</p>
            </div>

        </div>

        <div class="result-actions">
            <button class="btn btn-success" @onclick="SaveRiskProfile">
                Save
            </button>

            <button class="btn btn-secondary" @onclick="ResetRiskProfile">
                Try Again
            </button>
        </div>

    </section>
}

@if (!string.IsNullOrWhiteSpace(saveMessage))
{
    <p class="save-message"> @saveMessage </p>
}

@if (savedProfile is not null)
{
    <section class="risk-result">
        <h2> Your Current Risk Profile </h2>

        <div class="calculated-results">

            <p><strong> Profile: </strong> @savedProfile.ProfileName </p>

            <AllocationChart Profile="savedProfile" />


            <div class="result-div">
                <strong><span class="swatch stocks"></span> Stocks </strong>
                <p> @savedProfile.StocksPercentage% </p>
            </div>

            <div class="result-div">
                <strong><span class="swatch funds"></span> Funds </strong>
                <p> @savedProfile.FundsPercentage% </p>
            </div>

            <div class="result-div">
                <strong><span class="swatch low-risk"></span> Low risk / savings </strong>
                <p> @savedProfile.MinimalRiskPercentage% </p>
            </div>
        </div>
    </section>
    <br />
}