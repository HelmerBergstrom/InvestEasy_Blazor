@page "/RiskProfile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@using InvestEasy.Data
@using InvestEasy.Models
@using InvestEasy.Services
@using Microsoft.EntityFrameworkCore


<PageTitle> Risk Profile </PageTitle>

<PageHeader Title="Risk Profile" Icon="bi-pie-chart" Eyebrow="Tools" Width="narrow">
    Answer four quick questions to get a suggested portfolio allocation based on your goals and risk tolerance.
</PageHeader>

<div class="page-container narrow">

    @if (!hasResult)
    {
        <section aria-label="Questions">
            <RiskProfileQA Model="model" OnAnswerChanged="StateHasChanged" @key="model" />

            <div class="calculate-row">
                <button class="btn btn-primary-action btn-lg" @onclick="CalculateProfile" disabled="@(!CanCalculate)">
                    <i class="bi bi-calculator" aria-hidden="true"></i> Calculate risk profile
                </button>
                @if (!CanCalculate)
                {
                    <p class="muted"> Answer all four questions to continue. </p>
                }
            </div>
        </section>
    }
    else
    {
        <ProfileResult Profile="model" Heading="Suggested risk profile">
            <div class="result-actions">
                <button class="btn btn-primary-action" @onclick="SaveRiskProfile">
                    <i class="bi bi-bookmark" aria-hidden="true"></i> Save profile
                </button>
                <button class="btn btn-outline" @onclick="ResetRiskProfile">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Try again
                </button>
            </div>
        </ProfileResult>
    }

    <div role="status">
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <p class="message success"><i class="bi bi-check2-circle" aria-hidden="true"></i> @saveMessage </p>
        }
    </div>

    @if (savedProfile is not null)
    {
        <div class="saved-profile">
            <ProfileResult Profile="savedProfile" Heading="Your current risk profile" SavedDate="savedProfile.CreatedUtc" />
        </div>
    }

    <p class="disclaimer">
        The suggestion is a simplified guide for educational purposes and not financial advice.
    </p>
</div>
