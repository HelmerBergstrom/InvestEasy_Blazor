@using InvestEasy.Models

@* The four risk profile questions. Each question is a radio group, so it works with keyboard and screen readers. *@
<p class="answered-count" role="status">
    <strong>@AnsweredCount of @questions.Count</strong> questions answered
</p>

<div class="risk-profile-grid">
    @for (int q = 0; q < questions.Count; q++)
    {
        var question = questions[q];
        int number = q + 1;
        int selected = question.Get(Model);

        <fieldset class="question-card @(selected >= 0 ? "answered" : "")">
            <legend>
                <span class="question-number" aria-hidden="true">@number</span>
                <span class="visually-hidden">Question @number of @questions.Count: </span>
                @question.Text
            </legend>

            <div class="options">
                @for (int o = 0; o < question.Options.Length; o++)
                {
                    int value = o;
                    string id = $"{question.Name}-{value}";

                    <label class="option" for="@id">
                        <input type="radio" id="@id" name="@question.Name" value="@value"
                               checked="@(selected == value)"
                               @onchange="() => SetAnswer(question, value)" />
                        <span>@question.Options[o]</span>
                    </label>
                }
            </div>
        </fieldset>
    }
</div>

@code {
    [Parameter]
    public RiskProfileModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnAnswerChanged { get; set; }

    // A question, its answers (score 0-3 in order) and which property in the model it sets.
    private record Question(string Name, string Text, string[] Options, Func<RiskProfileModel, int> Get, Action<RiskProfileModel, int> Set);

    private readonly List<Question> questions = new()
    {
        new("time", "When do you expect to use this money?",
            new[] { "Within 1 year", "1–3 years", "3–7 years", "More than 7 years" },
            m => m.TimeHorizon, (m, v) => m.TimeHorizon = v),

        new("drop", "If your investments dropped 20%, what would you do?",
            new[] { "Sell everything", "Sell part of it", "Do nothing", "Invest more" },
            m => m.MarketDropReaction, (m, v) => m.MarketDropReaction = v),

        new("goal", "What is your main investment goal?",
            new[] { "Protect my money", "Grow steadily", "Balanced growth", "Maximize growth" },
            m => m.InvestmentGoal, (m, v) => m.InvestmentGoal = v),

        new("exp", "How experienced are you with investing?",
            new[] { "No experience", "Some experience", "Comfortable investor", "Experienced investor" },
            m => m.ExperienceLevel, (m, v) => m.ExperienceLevel = v)
    };

    private int AnsweredCount => questions.Count(q => q.Get(Model) >= 0);

    private async Task SetAnswer(Question question, int value)
    {
        question.Set(Model, value);
        await OnAnswerChanged.InvokeAsync();
    }
}
