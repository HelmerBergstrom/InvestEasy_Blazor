@using InvestEasy.Models

<div class="risk-profile-container">

    <!-- Question 1 -->
    <section class="question-card">
        <h3> When do you expect to use this money? </h3>

        <label>
            <input type="radio" name="time" @onclick="() => Model.TimeHorizon = 0">
            Within 1 year
        </label>

        <label>
            <input type="radio" name="time" @onclick="() => Model.TimeHorizon = 1">
            1–3 years
        </label>

        <label>
            <input type="radio" name="time" @onclick="() => Model.TimeHorizon = 2">
            3–7 years
        </label>

        <label>
            <input type="radio" name="time" @onclick="() => Model.TimeHorizon = 3">
            More than 7 years
        </label>
    </section>


    <!-- Question 2 -->
    <section class="question-card">
        <h3>If your investments dropped 20%, what would you do?</h3>

        <label>
            <input type="radio" name="drop" @onclick="() => Model.MarketDropReaction = 0">
            Sell everything
        </label>

        <label>
            <input type="radio" name="drop" @onclick="() => Model.MarketDropReaction = 1">
            Sell part of it
        </label>

        <label>
            <input type="radio" name="drop" @onclick="() => Model.MarketDropReaction = 2">
            Do nothing
        </label>

        <label>
            <input type="radio" name="drop" @onclick="() => Model.MarketDropReaction = 3">
            Invest more
        </label>
    </section>


    <!-- Question 3 -->
    <section class="question-card">
        <h3>What is your main investment goal?</h3>

        <label>
            <input type="radio" name="goal" @onclick="() => Model.InvestmentGoal = 0">
            Protect my money
        </label>

        <label>
            <input type="radio" name="goal" @onclick="() => Model.InvestmentGoal = 1">
            Grow steadily
        </label>

        <label>
            <input type="radio" name="goal" @onclick="() => Model.InvestmentGoal = 2">
            Balanced growth
        </label>

        <label>
            <input type="radio" name="goal" @onclick="() => Model.InvestmentGoal = 3">
            Maximize growth
        </label>
    </section>


    <!-- Question 4 -->
    <section class="question-card">
        <h3>How experienced are you with investing?</h3>

        <label>
            <input type="radio" name="exp" @onclick="() => Model.ExperienceLevel = 0">
            No experience
        </label>

        <label>
            <input type="radio" name="exp" @onclick="() => Model.ExperienceLevel = 1">
            Some experience
        </label>

        <label>
            <input type="radio" name="exp" @onclick="() => Model.ExperienceLevel = 2">
            Comfortable investor
        </label>

        <label>
            <input type="radio" name="exp" @onclick="() => Model.ExperienceLevel = 3">
            Experienced investor
        </label>
    </section>

    <!-- resterande frågor här -->

</div>

@code {
    [Parameter]
    public RiskProfileModel Model { get; set; } = default!;
}