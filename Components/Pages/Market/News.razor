@page "/market/news"
@using InvestEasy.Models
@using InvestEasy.Services
@inject MarketService MarketService

<PageTitle> Market News </PageTitle>

<MarketMenu Title="Market news" Icon="bi-newspaper"
            Description="The latest general market news from sources around the world." />

<section class="page-container" aria-label="News articles">
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="message error" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Couldn't load the news right now. Please try again later.
        </p>
    }
    else if (articles.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-newspaper" aria-hidden="true"></i>
            <p> No news available right now. </p>
        </div>
    }
    else
    {
        <ul class="news-grid">
            @foreach (NewsArticle a in articles.Take(MaxArticles))
            {
                <li>
                    <a href="@a.Url" class="news-card" target="_blank" rel="noopener noreferrer">
                        @if (!string.IsNullOrWhiteSpace(a.Image))
                        {
                            <img class="news-image" src="@a.Image" alt="" loading="lazy" />
                        }
                        <div class="news-body">
                            <div class="news-meta">
                                <span class="pill pill-info"> @a.Source </span>
                                <time datetime="@ToIsoTime(a.Datetime)"> @ToLocalTime(a.Datetime) </time>
                            </div>
                            <h2 class="news-headline"> @a.Headline </h2>
                            @if (!string.IsNullOrWhiteSpace(a.Summary))
                            {
                                <p class="news-summary"> @a.Summary </p>
                            }
                            <span class="news-cta">
                                Read article <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                <span class="visually-hidden">(opens in a new tab)</span>
                            </span>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
</section>

@code {
    private const int MaxArticles = 24;

    private string? error;
    private List<NewsArticle> articles = new List<NewsArticle>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // gets articles from category "general".
            articles = await MarketService.GetMarketNewsAsync(category: "general");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    // convert date which is unixtime in API, unix-timestamp = seconds passed after 1970-01-01.
    // Converts to DateTime UTC first, then LocalTime and at last to a string for UI purposes.
    private static string ToLocalTime(long unixSeconds)
    => DateTimeOffset.FromUnixTimeSeconds(unixSeconds)
    .ToLocalTime()
    .ToString(format: "yyyy-MM-dd HH:mm");

    // Machine readable time for the <time> element.
    private static string ToIsoTime(long unixSeconds)
    => DateTimeOffset.FromUnixTimeSeconds(unixSeconds).ToString("o");
}
