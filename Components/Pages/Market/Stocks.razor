@page "/market/stocks"
@using InvestEasy.Services
@using InvestEasy.Models
@inject MarketService MarketService

<PageTitle> Popular Stocks </PageTitle>

<MarketMenu Title="Popular stocks" Icon="bi-building" Description="Prices and daily changes for some of the largest companies in the world." />

<section class="page-container" aria-label="Popular stocks">
    <ul class="quote-grid">
        @foreach (QuoteItem item in items)
        {
            <li>
                <QuoteCard Name="@item.Name" Symbol="@item.Symbol" Quote="item.Quote" />
            </li>
        }
    </ul>

    <p class="disclaimer">
        Prices in USD from Finnhub, updated about once a minute. Not a recommendation to buy or sell.
    </p>
</section>

@code {
    private List<QuoteItem> items = new List<QuoteItem>()
    {
        new QuoteItem() { Name = "Apple Inc.", Symbol = "AAPL" },
        new QuoteItem() { Name = "Microsoft Corporation", Symbol = "MSFT" },
        new QuoteItem() { Name = "Nvidia Corporation", Symbol = "NVDA" },
        new QuoteItem() { Name = "Amazon.com, Inc.", Symbol = "AMZN" },
        new QuoteItem() { Name = "Alphabet Inc.", Symbol = "GOOG" },
        new QuoteItem() { Name = "Meta Platforms, Inc.", Symbol = "META" },
        new QuoteItem() { Name = "Tesla, Inc.", Symbol = "TSLA" }
    };

    // Fetches all quotes in parallel before the page is rendered.
    protected override async Task OnInitializedAsync()
    {
        IEnumerable<Task> tasks = items.Select(async item =>
        {
            item.Quote = await MarketService.GetIndexQuoteAsync(item.Symbol);
        });

        await Task.WhenAll(tasks);
    }

    // Simple view model representing a stock and its latest quote/numbers
    private class QuoteItem
    {
        public string Name { get; set; } = "";
        public string Symbol { get; set; } = "";
        public IndexQuote? Quote { get; set; }
    }
}
