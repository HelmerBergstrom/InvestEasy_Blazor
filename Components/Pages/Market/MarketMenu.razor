<div class="page-header">
    <h1 class="page-title"> Market </h1>
    <p class="page-subtitle">
        Stay informed with the latest market news, track major indexes, and explore individual stocks.
    </p>
</div>

<div class="market-menu-container">
    <p> What would you like to explore? </p>
    <div class="market-menu">
        <div class="nav-item">
            <NavLink href="/market/news" class="nav-link" Match="NavLinkMatch.All" ActiveClass="active">
                News
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink href="/market/indexes" class="nav-link" ActiveClass="active">
                Indexes
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink href="/market/stocks" class="nav-link" ActiveClass="active">
                Popular stocks
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <NavLink href="/market/watchlist" class="nav-link" ActiveClass="active">
                        My watchlist
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink href="Account/Login" class="nav-link">
                        My watchlist 🔒
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>