@* Shared header and section tabs for all market pages. *@
<PageHeader Title="@Title" Icon="@Icon" Eyebrow="Market">
    @Description
</PageHeader>

<nav class="market-tabs-wrapper" aria-label="Market sections">
    <ul class="market-tabs">
        <li>
            <NavLink href="/market/news" class="market-tab" ActiveClass="active">
                <i class="bi bi-newspaper" aria-hidden="true"></i> News
            </NavLink>
        </li>
        <li>
            <NavLink href="/market/indexes" class="market-tab" ActiveClass="active">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Indexes
            </NavLink>
        </li>
        <li>
            <NavLink href="/market/stocks" class="market-tab" ActiveClass="active">
                <i class="bi bi-building" aria-hidden="true"></i> Popular stocks
            </NavLink>
        </li>
        <li>
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/market/watchlist" class="market-tab" ActiveClass="active">
                        <i class="bi bi-eye" aria-hidden="true"></i> My watchlist
                    </NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="Account/Login" class="market-tab">
                        <i class="bi bi-lock" aria-hidden="true"></i> My watchlist
                        <span class="visually-hidden">(requires login)</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </li>
    </ul>
</nav>

@code {
    [Parameter] public string Title { get; set; } = "Market";
    [Parameter] public string Icon { get; set; } = "bi-graph-up";
    [Parameter] public string Description { get; set; } =
        "Stay informed with the latest market news, track major indexes and explore individual stocks.";
}
