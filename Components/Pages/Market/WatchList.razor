@page "/market/watchlist"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Routing
@using InvestEasy.Services
@using InvestEasy.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject CurrentUserService CurrentUserService
@inject MarketService MarketService
@inject WatchListService WatchListService

<PageTitle> My Watchlist </PageTitle>

<MarketMenu />

<section class="watchlist">

    <input placeholder="Search stocks (Apple, Microsoft...)" @bind="searchQuery" @bind:event="oninput"
        @onclick="ClearMessage" class="form-control" />
    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@isSearching">
        @(isSearching ? "Searching..." : "Search")
    </button>

    @if (searchResults.Count > 0)
    {
        <h2> Search Results </h2>

        @foreach (SymbolSearchItem result in searchResults.Take(count: 10))
        {
            <div class="index-card">

                <div>
                    <strong>@result.Description</strong>
                    <p>@result.Symbol - @result.Type</p>
                </div>

                <button class="btn btn-success" @onclick="() => AddToWatchlist(result)">
                    ADD
                </button>
            </div>
        }
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="message-text">@message</p>
    }

    <h2> My Watchlist </h2>


    @if (watchListItems.Count == 0)
    {
        <p> No saved stocks yet. Search and find stocks to add to the watchlist. </p>
    }
    else
    {
        @foreach (WatchListItemModel item in watchListItems)
        {
            <div class="index-card">
                <div class="index-card-text">
                    <strong>@item.Name</strong>
                    <p>@item.Symbol - @item.Type</p>
                </div>

                <div class="index-card-values">
                    @if (watchlistQuotes.TryGetValue(item.Symbol, out IndexQuote? quote) && quote is not null)
                    {
                        <p><strong>@quote.C.ToString("0.00")</strong></p>
                        <span class="@(quote.D >= 0 ? "positive" : "negative")">
                            @quote.D.ToString("0.00")
                            (@quote.Dp.ToString("0.00")%)
                        </span>
                    }
                    else
                    {
                        <p><strong> No values detected </strong></p>
                    }
                </div>

                <button class="btn btn-secondary" @onclick="() => RemoveFromWatchList(item.Id)">
                    🗑️
                </button>
            </div>
        }
    }

</section>

@code {
    private List<WatchListItemModel> watchListItems = new List<WatchListItemModel>();
    private List<SymbolSearchItem> searchResults = new List<SymbolSearchItem>();
    private Dictionary<string, IndexQuote?> watchlistQuotes = new Dictionary<string, IndexQuote?>();

    private string? message;
    private string searchQuery = "";
    private bool isSearching;

    // loading watchlist when component is active.
    protected override async Task OnInitializedAsync()
    {
        await LoadWatchListAsync();
    }

    private async Task LoadWatchListAsync()
    {
        string? userId = await CurrentUserService.GetUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        watchListItems = await WatchListService.GetForUserAsync(userId);

        watchlistQuotes.Clear();

        IEnumerable<Task> tasks = watchListItems.Select(async item =>
        {
            watchlistQuotes[item.Symbol] = await MarketService.GetIndexQuoteAsync(item.Symbol);
            await InvokeAsync(StateHasChanged);
        });

        await Task.WhenAll(tasks);
    }

    private void ClearMessage()
    {
        message = null;
    }

    private async Task SearchAsync()
    {
        message = null;

        // Validation of input.
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults.Clear();
            return;
        }

        // set searching to true to disable button.
        isSearching = true;

        try
        {
            searchResults = await MarketService.SearchSymbolAsync(searchQuery);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            searchResults = new List<SymbolSearchItem>();
        }
        finally
        {
            isSearching = false;
            // Notifies the component that its state has changed.
            // When applicable, this will cause the component to be re-rendered.
            StateHasChanged();
        }
    }

    // add a stock to watchlist.
    private async Task AddToWatchlist(SymbolSearchItem item)
    {
        // gets userId.
        string? userId = await CurrentUserService.GetUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        // new watchlist item.
        bool added = await WatchListService.AddAsync(
        userId,
        item.Symbol ?? "",
        item.Description ?? "",
        item.Type
        );

        message = added ? "Stock added to watchlist." : "That stock is already in your watchlist.";

        // reset search UI after adding
        searchQuery = "";
        searchResults.Clear();

        await LoadWatchListAsync();
    }

    // remove one stock from watchlist via id and userId.
    private async Task RemoveFromWatchList(int id)
    {
        string? userId = await CurrentUserService.GetUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        await WatchListService.RemoveAsync(userId, id);
        await LoadWatchListAsync();
    }
}