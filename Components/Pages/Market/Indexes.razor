@page "/market/indexes"
@using Microsoft.AspNetCore.Components.Routing
@using InvestEasy.Services
@using InvestEasy.Models
@inject MarketService MarketService

<PageTitle> Indexes </PageTitle>

<MarketMenu />

@foreach (IndexItem index in indexes)
{
    <div class="index-card">
        <h3>@index.Name</h3>
        @if (index.Quote is null)
        {
            <span class="loading"> Loading... </span>
        }
        else
        {
            <span class="@(index.Quote.D >= 0 ? "positive" : "negative")">
                @index.Quote.Dp.ToString("0.00")%
            </span>
        }
    </div>
}

@code {

    // Fetches all quotes in parallel, and updates each card as data arrives instead of waiting for everything to arrive.
    protected override async Task OnInitializedAsync()
    {
        IEnumerable<Task>? tasks = indexes.Select(async index =>
        {
            index.Quote = await MarketService.GetIndexQuoteAsync(index.Symbol);
            await InvokeAsync(StateHasChanged);
        });

        await Task.WhenAll(tasks);
    }
    private List<IndexItem> indexes = new List<IndexItem>()
{
new IndexItem() { Name = "S&P 500", Symbol = "SPY" },
new IndexItem() { Name = "NASDAQ", Symbol = "QQQ" },
new IndexItem() { Name = "DAX", Symbol = "DAX" },
new IndexItem() { Name = "GOLD", Symbol = "GLD" },
new IndexItem() { Name = "SILVER", Symbol = "SLV" },
new IndexItem() { Name = "OIL", Symbol = "USO" },
new IndexItem() { Name = "BITCOIN", Symbol = "IBIT" }
};

    // Simple view model representing an index/asset and its latest quote/numbers
    public class IndexItem
    {
        public string Name { get; set; } = "";
        public string Symbol { get; set; } = "";
        public IndexQuote? Quote { get; set; }
    }

}