@page "/market/indexes"
@using InvestEasy.Services
@using InvestEasy.Models
@inject MarketService MarketService

<PageTitle> Indexes </PageTitle>

<MarketMenu Title="Indexes & assets" Icon="bi-bar-chart-line" Description="Follow how major indexes, commodities and bitcoin are moving today." />

<section class="page-container" aria-label="Indexes & assets">
    <ul class="quote-grid">
        @foreach (QuoteItem item in items)
        {
            <li>
                <QuoteCard Name="@item.Name" Symbol="@item.Symbol" Quote="item.Quote" />
            </li>
        }
    </ul>

    <p class="disclaimer">
        Indexes and assets are tracked through US-listed ETFs (the symbol on each card), so prices are the ETF price in USD. Data from Finnhub, updated about once a minute.
    </p>
</section>

@code {
    private List<QuoteItem> items = new List<QuoteItem>()
    {
        new QuoteItem() { Name = "S&P 500", Symbol = "SPY" },
        new QuoteItem() { Name = "NASDAQ 100", Symbol = "QQQ" },
        new QuoteItem() { Name = "DAX", Symbol = "DAX" },
        new QuoteItem() { Name = "Gold", Symbol = "GLD" },
        new QuoteItem() { Name = "Silver", Symbol = "SLV" },
        new QuoteItem() { Name = "Oil", Symbol = "USO" },
        new QuoteItem() { Name = "Bitcoin", Symbol = "IBIT" }
    };

    // Fetches all quotes in parallel before the page is rendered.
    protected override async Task OnInitializedAsync()
    {
        IEnumerable<Task> tasks = items.Select(async item =>
        {
            item.Quote = await MarketService.GetIndexQuoteAsync(item.Symbol);
        });

        await Task.WhenAll(tasks);
    }

    // Simple view model representing an index/asset and its latest quote/numbers
    private class QuoteItem
    {
        public string Name { get; set; } = "";
        public string Symbol { get; set; } = "";
        public IndexQuote? Quote { get; set; }
    }
}
