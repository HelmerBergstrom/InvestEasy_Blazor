@implements IDisposable

@inject NavigationManager NavigationManager

<header class="nav-container">

    <NavLink href="/" Match="NavLinkMatch.All" class="nav-logo">
        <img src="images/logo.png" class="logo" alt="Logotyp">
    </NavLink>

    <nav class="nav-links">
        <div class="nav-item px-3">
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All" ActiveClass="active">
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink href="/education" class="nav-link" ActiveClass="active">
                Education
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="/riskProfile" class="nav-link" ActiveClass="active">
                Risk Profile
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="/savingCalc" class="nav-link" ActiveClass="active" aria-hidden="true">
                Saving Calculator
            </NavLink>
        </div>


        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        Profile
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}